# Variables d'environnement — Backend Tsinjo Aina API
# Copier ce fichier en .env et remplir les valeurs réelles

# ─── Base de données ──────────────────────────────────────────────
# Supabase : Settings > Database > Connection string (Transaction mode)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ─── Authentification JWT ─────────────────────────────────────────
# Clé secrète forte (min 32 caractères) — générer avec : openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long
JWT_EXPIRES_IN=24h

# ─── Serveur ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────
# URL du frontend Next.js (Vercel)
# Développement local : http://localhost:3000
# Production : https://tsinjoaina.org (ou votre domaine Vercel)
CORS_ORIGIN=http://localhost:3000
